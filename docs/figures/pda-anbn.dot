digraph G {
  rankdir=LR; bgcolor="white"; pad=0.2; nodesep=0.45; ranksep=0.55;
  node [shape=circle fontname="Inter" fontsize=13 color="#4338ca" penwidth=1.6 fontcolor="#1e1b4b" style=filled fillcolor="#eef2ff" width=0.55 fixedsize=false];
  edge [fontname="Inter" fontsize=11 color="#64748b" fontcolor="#334155" arrowsize=0.7];
  __start [shape=point width=0.06 color="#4338ca"];
  "q0" [shape=circle label="q0"];
  "q1" [shape=circle label="q1"];
  "q2" [shape=circle label="q2"];
  "q3" [shape=doublecircle label="q3" fillcolor="#fef3c7" color="#b45309"];
  __start -> "q0";
  "q0" -> "q1" [label="a, Z → XZ"];
  "q1" -> "q1" [label="a, X → XX"];
  "q1" -> "q2" [label="b, X → ε"];
  "q2" -> "q2" [label="b, X → ε"];
  "q2" -> "q3" [label="ε, Z → Z"];
  "q0" -> "q3" [label="ε, Z → Z"];
}