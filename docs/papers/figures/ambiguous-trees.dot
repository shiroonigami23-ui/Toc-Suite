digraph G { graph [bgcolor="transparent", rankdir=TB, nodesep=0.25, ranksep=0.35]; node [shape=circle, fontname="Helvetica", fontsize=12, width=0.38, style=filled, fillcolor="#ccfbf1", color="#0f766e"]; edge [arrowhead=none, color="#64748b"];
subgraph cluster_a { label="a + (a · a)"; fontname="Helvetica"; color="#cbd5e1";
 E1 [label="E"]; E2 [label="E"]; P1 [label="+", fillcolor="#fff7ed", color="#ea580c"]; E3 [label="E"]; a1 [label="a", fillcolor="#fff7ed", color="#ea580c"]; E4 [label="E"]; M1 [label="*", fillcolor="#fff7ed", color="#ea580c"]; E5 [label="E"]; a2 [label="a", fillcolor="#fff7ed", color="#ea580c"]; a3 [label="a", fillcolor="#fff7ed", color="#ea580c"];
 E1 -> E2; E1 -> P1; E1 -> E3; E2 -> a1; E3 -> E4; E3 -> M1; E3 -> E5; E4 -> a2; E5 -> a3; }
subgraph cluster_b { label="(a + a) · a"; fontname="Helvetica"; color="#cbd5e1";
 F1 [label="E"]; F2 [label="E"]; M2 [label="*", fillcolor="#fff7ed", color="#ea580c"]; F3 [label="E"]; F4 [label="E"]; P2 [label="+", fillcolor="#fff7ed", color="#ea580c"]; F5 [label="E"]; b1 [label="a", fillcolor="#fff7ed", color="#ea580c"]; b2 [label="a", fillcolor="#fff7ed", color="#ea580c"]; b3 [label="a", fillcolor="#fff7ed", color="#ea580c"];
 F1 -> F2; F1 -> M2; F1 -> F3; F2 -> F4; F2 -> P2; F2 -> F5; F4 -> b1; F5 -> b2; F3 -> b3; } }
