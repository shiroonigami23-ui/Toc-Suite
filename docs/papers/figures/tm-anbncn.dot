digraph G { graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", nodesep=0.5, ranksep=0.6]; node [shape=circle, fontname="Helvetica", fontsize=13, width=0.5, style=filled, fillcolor="#eef2ff", color="#4338ca", penwidth=1.6]; edge [fontname="Helvetica", fontsize=12, color="#475569", arrowsize=0.8]; start [shape=point, width=0.01, style=invis]; ranksep=0.9;
acc [shape=doublecircle, label="acc"]; start -> q0;
